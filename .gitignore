__pycache__/
*.py[cod]
.venv/
.idea/
.vscode/
.pytest_cache/

# 本地资料库及抓取产物不得提交
# 用 data/* 而不是 data/，这样目录本身不被排除，才能用 ! 放行 .gitkeep
data/*
output/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
raw/

# data/ 目录本身要保留（部署时把数据库放进去），只忽略内容
!data/.gitkeep

# 素材清单与自产占位图要进仓库：它们是插件自己生成的，不含第三方素材
# 若日后放入真实角色立绘 / 武器图，请先确认授权，再把 data/assets/characters
# 与 data/assets/weapons 加回忽略列表
!data/assets/
