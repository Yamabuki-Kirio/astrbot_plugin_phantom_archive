__pycache__/
*.py[cod]
.venv/
.idea/
.vscode/
.pytest_cache/

# 本地资料库及抓取产物不得提交
# 用 data/* 而不是 data/，这样目录本身不被排除，才能用 ! 放行 .gitkeep
data/*
output/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
raw/

# data/ 目录本身要保留（部署时把数据库放进去），只忽略内容
!data/.gitkeep

# 素材清单与占位图要进仓库：占位图是插件自己画的，清单只是索引，都不含第三方素材
!data/assets/

# 官网角色立绘 / 武器图**不进仓库**：版权归游戏发行方，仓库只放索引（manifest.json）
# 与自绘占位图，实际图片由使用者自己跑 scripts/fetch_official_art.py 下载到本地。
data/assets/characters/
data/assets/weapons/
