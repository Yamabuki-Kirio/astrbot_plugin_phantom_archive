__pycache__/
*.py[cod]
.venv/
.idea/
.vscode/
.pytest_cache/

# 本地资料库及抓取产物不得提交
# 用 data/* 而不是 data/，这样目录本身不被排除，才能用 ! 放行 .gitkeep
data/*
output/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
raw/

# 发布只读中文资料库；运行期生成的 p5x_daily.sqlite3 等数据库仍保持忽略。
!data/p5x_zh.sqlite3

# data/ 目录本身要保留（部署时把数据库放进去），只忽略内容
!data/.gitkeep
!data/p5x_zh.sqlite3

# 素材清单与占位图要进仓库：占位图是插件自己画的，清单只是索引，都不含第三方素材
!data/assets/

# 角色与武器素材随版本发布，使 Docker/GitHub 安装后无需在启动阶段联网。
# 每一项来源与来源状态记录在 manifest.json；不要提交未登记来源的素材。
